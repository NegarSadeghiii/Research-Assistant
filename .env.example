# Research-Assistant — credential key names only. Never commit real values.
# Populated from Blueprint Q2 (CLAUDE.md §2.5). Nothing here is verified yet —
# see CLAUDE.md §2.6 for measured reachability from the remote container.

# --- Stage 1: external discovery ---------------------------------------------

# OpenAlex — API key MANDATORY since 2026-02-13 (polite pool / mailto discontinued).
# Free key with a daily allowance: https://openalex.org/settings/api
OPENALEX_API_KEY=

# Semantic Scholar Academic Graph — works unauthenticated at low rate limits;
# a key raises them. Request: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# NCBI E-utilities (PubMed / PMC) — key optional, raises 3/s to 10/s.
# Identify yourself per NCBI policy.
NCBI_API_KEY=
NCBI_TOOL_NAME=research-assistant
NCBI_EMAIL=

# Crossref — no key. A contact address joins the polite pool.
CROSSREF_MAILTO=

# --- Not configured by design ------------------------------------------------
# Zotero    : accessed via the existing connector (D-009). Web API only if the
#             connector proves insufficient in Phase L — do not add keys before then.
# Consensus : authenticated as a Claude connector; no key in this file.
# Scopus / Web of Science : deferred, no institutional credentials (D-011).
# Google Scholar : excluded — no official API, scraping rejected (BR-7).
